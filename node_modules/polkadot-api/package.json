{
  "name": "polkadot-api",
  "version": "2.2.2",
  "author": "Josep M Sobrepere (https://github.com/josepot)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polkadot-api/polkadot-api.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "bin": {
    "papi": "./bin/cli.js",
    "polkadot-api": "./bin/cli.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/src/index.js",
        "default": "./dist/src/index.js"
      },
      "types": "./dist/src/index.d.ts",
      "module": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./logs-provider": {
      "types": "./dist/reexports/logs-provider.d.ts",
      "module": "./dist/reexports/logs-provider.js",
      "import": "./dist/reexports/logs-provider.js",
      "default": "./dist/reexports/logs-provider.js"
    },
    "./pjs-signer": {
      "types": "./dist/reexports/pjs-signer.d.ts",
      "module": "./dist/reexports/pjs-signer.js",
      "import": "./dist/reexports/pjs-signer.js",
      "default": "./dist/reexports/pjs-signer.js"
    },
    "./signer": {
      "types": "./dist/reexports/signer.d.ts",
      "module": "./dist/reexports/signer.js",
      "import": "./dist/reexports/signer.js",
      "default": "./dist/reexports/signer.js"
    },
    "./sm-provider": {
      "types": "./dist/reexports/sm-provider.d.ts",
      "module": "./dist/reexports/sm-provider.js",
      "import": "./dist/reexports/sm-provider.js",
      "default": "./dist/reexports/sm-provider.js"
    },
    "./chains": {
      "types": "./dist/reexports/chains.d.ts",
      "module": "./dist/reexports/chains.js",
      "import": "./dist/reexports/chains.js",
      "default": "./dist/reexports/chains.js"
    },
    "./chains/*": {
      "types": "./dist/reexports/chains_*.d.ts",
      "module": "./dist/reexports/chains_*.js",
      "import": "./dist/reexports/chains_*.js",
      "default": "./dist/reexports/chains_*.js"
    },
    "./smoldot": {
      "types": "./dist/reexports/smoldot.d.ts",
      "module": "./dist/reexports/smoldot.js",
      "import": "./dist/reexports/smoldot.js",
      "default": "./dist/reexports/smoldot.js"
    },
    "./smoldot/*": {
      "types": "./dist/reexports/smoldot_*.d.ts",
      "module": "./dist/reexports/smoldot_*.js",
      "import": "./dist/reexports/smoldot_*.js",
      "default": "./dist/reexports/smoldot_*.js"
    },
    "./utils": {
      "types": "./dist/reexports/utils.d.ts",
      "module": "./dist/reexports/utils.js",
      "import": "./dist/reexports/utils.js",
      "default": "./dist/reexports/utils.js"
    },
    "./ink": {
      "types": "./dist/reexports/ink.d.ts",
      "module": "./dist/reexports/ink.js",
      "import": "./dist/reexports/ink.js",
      "default": "./dist/reexports/ink.js"
    },
    "./ws": {
      "types": "./dist/reexports/ws.d.ts",
      "module": "./dist/reexports/ws.js",
      "import": "./dist/reexports/ws.js",
      "default": "./dist/reexports/ws.js"
    }
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "browser": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "bin",
    "logs-provider",
    "pjs-signer",
    "signer",
    "sm-provider",
    "chains",
    "smoldot",
    "utils",
    "ink",
    "ws"
  ],
  "peerDependencies": {
    "rxjs": ">=7.8.0"
  },
  "dependencies": {
    "@rx-state/core": "^0.1.4",
    "@polkadot-api/ink-contracts": "0.6.3",
    "@polkadot-api/cli": "0.21.10",
    "@polkadot-api/known-chains": "0.12.1",
    "@polkadot-api/logs-provider": "0.2.0",
    "@polkadot-api/metadata-builders": "0.14.3",
    "@polkadot-api/json-rpc-provider": "0.2.0",
    "@polkadot-api/metadata-compatibility": "0.6.3",
    "@polkadot-api/pjs-signer": "0.7.3",
    "@polkadot-api/observable-client": "0.18.8",
    "@polkadot-api/polkadot-signer": "0.1.6",
    "@polkadot-api/signer": "0.3.3",
    "@polkadot-api/substrate-bindings": "0.20.3",
    "@polkadot-api/substrate-client": "0.7.0",
    "@polkadot-api/smoldot": "0.4.6",
    "@polkadot-api/utils": "0.4.0",
    "@polkadot-api/sm-provider": "0.3.8",
    "@polkadot-api/ws-provider": "0.9.1",
    "@polkadot-api/ws-middleware": "0.3.6"
  },
  "devDependencies": {
    "rxjs": "^7.8.2",
    "@polkadot-api/codegen": "0.22.5"
  },
  "scripts": {
    "build-core": "tsc --noEmit && rollup -c",
    "build": "pnpm build-core",
    "test": "echo 'no tests'",
    "lint": "prettier --check README.md \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "format": "prettier --write README.md \"src/**/*.{js,jsx,ts,tsx,json,md}\""
  }
}