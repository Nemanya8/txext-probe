{
  "name": "@polkadot-api/cli",
  "version": "0.21.10",
  "author": "Victor Oliva (https://github.com/voliva)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polkadot-api/polkadot-api.git"
  },
  "license": "MIT",
  "sideEffects": true,
  "type": "module",
  "bin": {
    "papi": "./dist/main/src/main.js",
    "polkadot-api": "./dist/main/src/main.js"
  },
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@polkadot-api/wasm-executor": "^0.2.3",
    "@types/node": "^25.9.4",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "fs.promises.exists": "^1.1.4",
    "ora": "^9.4.1",
    "read-pkg": "^10.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "rxjs": "^7.8.2",
    "tsc-prog": "^2.3.0",
    "typescript": "^6.0.3",
    "write-package": "^7.2.0",
    "@polkadot-api/json-rpc-provider": "0.2.0",
    "@polkadot-api/codegen": "0.22.5",
    "@polkadot-api/known-chains": "0.12.1",
    "@polkadot-api/ink-contracts": "0.6.3",
    "@polkadot-api/metadata-compatibility": "0.6.3",
    "@polkadot-api/observable-client": "0.18.8",
    "@polkadot-api/sm-provider": "0.3.8",
    "@polkadot-api/substrate-bindings": "0.20.3",
    "@polkadot-api/substrate-client": "0.7.0",
    "@polkadot-api/ws-provider": "0.9.1",
    "@polkadot-api/ws-middleware": "0.3.6",
    "@polkadot-api/utils": "0.4.0",
    "@polkadot-api/smoldot": "0.4.6"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@polkadot-api/json-rpc-provider": "0.2.0"
  },
  "scripts": {
    "build-core": "tsc --noEmit && rollup -c",
    "build": "pnpm build-core",
    "start": "pnpm build && node --enable-source-maps dist/main.js",
    "test": "echo 'no tests'",
    "lint": "prettier --check README.md \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "format": "prettier --write README.md \"src/**/*.{js,jsx,ts,tsx,json,md}\""
  }
}